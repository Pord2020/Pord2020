# Copy to .env.local. Never commit actual credentials.
APP_URL=http://localhost:3000
APP_MODE=sandbox
DATABASE_MODE=embedded
# Required in production. Prefer Railway's private PostgreSQL URL.
# DATABASE_URL=postgresql://...
# Railway is the trusted single reverse proxy when TRUST_PROXY=1.
TRUST_PROXY=0
# Optional Google OIDC. Use a dedicated OAuth client and exact callback URL:
# http://localhost:3000/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Chile: planned real collection uses Mercado Pago (CLP) and rewards use PayPal (USD).
# Live collection remains closed pending provider eligibility, fee, FX, and operational validation.
# Put real runtime secrets directly in Railway's secure variables, never in Git.
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_WEBHOOK_SECRET=
# USD_CLP_RATE=  # Approved CLP per USD rate, up to 4 decimal places; no guessed default.
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
LIVE_PAYOUTS_READY=false
